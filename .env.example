# Скопируй в .env и заполни. SAYR_ADMIN_PASSWORD и SAYR_SECRET_KEY обязательны —
# без них приложение не стартует. Это намеренно: дефолт из публичного репозитория
# означал бы открытую админку.

SAYR_DATABASE_URL=postgresql+psycopg://sayr:CHANGE_ME@localhost:5432/sayr

SAYR_ADMIN_USERNAME=admin
SAYR_ADMIN_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
SAYR_SECRET_KEY=

# Cookie админки только по HTTPS. Локально по http — false
SAYR_ADMIN_COOKIE_SECURE=true

# Необязательное
# SAYR_MEDIA_DIR=./media
# SAYR_WEATHER_CACHE_TTL_SEC=1800
# Срок хранения сырых событий статистики; должен совпадать с обещанным
# на странице /privacy. Дневные агрегаты живут вечно
# SAYR_STATS_RETENTION_DAYS=30
# Нужен только веб-морде; нативным клиентам CORS не требуется
# SAYR_CORS_ORIGINS=["https://sayr.uz"]
