# Скопируй в .env и заполни. SAYR_ADMIN_PASSWORD и SAYR_SECRET_KEY обязательны —
# без них приложение не стартует. Это намеренно: дефолт из публичного репозитория
# означал бы открытую админку.

SAYR_DATABASE_URL=postgresql+psycopg://sayr:CHANGE_ME@localhost:5432/sayr

SAYR_ADMIN_USERNAME=admin
SAYR_ADMIN_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
SAYR_SECRET_KEY=

# Cookie админки только по HTTPS. Локально по http — false
SAYR_ADMIN_COOKIE_SECURE=true

# Необязательное
# Пароль страницы проверки сезонов (/seasons/review). Пусто — пускает
# по админскому. Задайте, когда проверку отдаёте кому-то из клуба:
# вместе с ней не должна уезжать вся админка
# SAYR_REVIEW_PASSWORD=
# SAYR_MEDIA_DIR=./media
# SAYR_WEATHER_CACHE_TTL_SEC=1800
# Срок хранения сырых событий статистики; должен совпадать с обещанным
# на странице /privacy. Дневные агрегаты живут вечно
# SAYR_STATS_RETENTION_DAYS=30
# Пуши: без ключей платформа считается ненастроенной, см. docs/superpowers/specs/2026-09-05-push-announcements-design.md
# SAYR_APNS_KEY_PATH=/etc/sayr/AuthKey_XXXXXXXXXX.p8
# SAYR_APNS_KEY_ID=XXXXXXXXXX
# SAYR_APNS_SANDBOX=false
# SAYR_FCM_SERVICE_ACCOUNT_PATH=/etc/sayr/firebase-service-account.json
# Нужен только веб-морде; нативным клиентам CORS не требуется
# SAYR_CORS_ORIGINS=["https://sayr.uz"]
# Копия ночных бэкапов вне сервера (deploy/backup.sh): rsync по ssh
# или rclone:<remote>:<путь>. Пусто — бэкапы только на этом диске.
# В дампах телефоны: для облака — rclone-remote типа crypt
# SAYR_BACKUP_REMOTE=backup@storage.example:/srv/sayr
# Сколько живёт вход в админку, в секундах; по умолчанию 12 часов
# SAYR_ADMIN_SESSION_MAX_AGE_SEC=43200
# /docs и /openapi.json — только локально, на бою не включать
# SAYR_API_DOCS=true
# Вход через Telegram (OpenID Connect): ID бота из @BotFather — он же aud
# в ID-токене; пусто — вход через Telegram выключен. Client ID по умолчанию
# равен ID бота. Client Secret нужен только для обмена кода на токен
# SAYR_TG_LOGIN_BOT_ID=
# SAYR_TG_LOGIN_CLIENT_ID=
# SAYR_TG_LOGIN_CLIENT_SECRET=
# Токен бота входа для будущих личных сообщений (SOS, напоминания); входу не нужен
# SAYR_TG_BOT_TOKEN=
# Вход с Apple: bundle id и Team ID уже по умолчанию; Key ID и ключ Sign in
# with Apple (.p8) — для отзыва доступа при удалении аккаунта
# SAYR_APPLE_BUNDLE_ID=uz.sayr.ios
# SAYR_APPLE_TEAM_ID=Z39Z5TJZCG
# SAYR_APPLE_KEY_ID=XXXXXXXXXX
# SAYR_APPLE_KEY_PATH=/etc/sayr/AuthKey_SIWA_XXXXXXXXXX.p8
# «Войти по номеру» в приложениях: включать, когда в Fragment есть деньги,
# и на время проверки Google Play
# SAYR_PHONE_LOGIN=false
